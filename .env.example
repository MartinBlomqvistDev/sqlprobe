# Copy to .env and fill in the values you need.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# One of: anthropic | gemini | groq | ollama
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Reasoning depth: low | medium | high | xhigh | max. Leave empty to use the
# model default. Lower settings cut latency and cost on routine questions.
ANTHROPIC_EFFORT=medium

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, OpenAI-compatible endpoint, no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The demo ships with SQLite so the template runs with zero setup.
# Swapping to another engine is a one-line change here:
#   MariaDB  : mysql+asyncmy://reader:pw@localhost:3306/analytics
#   Postgres : postgresql+asyncpg://reader:pw@localhost:5432/analytics
# Point it at a read-only database user in production.
DATABASE_URL=sqlite+aiosqlite:///data/demo.db

# The pseudonymisation directory: the only store that holds names and e-mail
# addresses. Never reachable from the LLM, only from the resolve endpoint.
DIRECTORY_URL=sqlite+aiosqlite:///data/directory.db

# ---------------------------------------------------------------------------
# Query limits
# ---------------------------------------------------------------------------
# Hard cap applied to every query before it reaches the database.
MAX_ROWS=1000
# Rows fed back into the LLM context. The client still receives the full
# result set over SSE; the model only needs enough to summarise.
LLM_MAX_ROWS=100

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins. Leave empty for local
# development, which falls back to "*". Always set this before deploying.
ALLOWED_ORIGINS=
# If set, every request to /api/chat must send the same value as X-API-Key.
API_KEY=
LOG_LEVEL=INFO
